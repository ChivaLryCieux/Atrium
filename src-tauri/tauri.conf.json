{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atrium",
  "version": "0.3.0",
  "identifier": "com.atrium.terminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm bundle:runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atrium // 智役中庭",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/bridge": "bridge/",
      "resources/cordis": "cordis/",
      "resources/node": "node/",
      "resources/kernel-manifest.json": "kernel-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
